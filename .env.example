# =============================================================================
# Sentinel IAM & Audit Service - environment configuration
#
# Create your local .env with freshly generated secrets:
#     make env
# Values written as __GENERATE_*__ are replaced with random secrets by
# scripts/generate_env.py. Never commit a real .env file.
# =============================================================================

# --- Host publishing (Docker Compose) ----------------------------------------
# 127.0.0.1 keeps the API reachable from this machine only. Use 0.0.0.0 to
# expose it on the local network.
SENTINEL_BIND_ADDRESS=127.0.0.1
SENTINEL_HTTP_PORT=8000
SENTINEL_IMAGE=sentinel-iam-audit-service:local
# Optional PyPI mirror used while building images (empty = pypi.org). Packages
# are still hash-verified against requirements*.txt. Do not embed credentials.
PIP_INDEX_URL=

# --- Django core --------------------------------------------------------------
DJANGO_SECRET_KEY=__GENERATE_SECRET__
# Never enable DEBUG outside local development.
DJANGO_DEBUG=false
# Keep 127.0.0.1 in the list: the container health check calls the API locally.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (scheme://host[:port]) trusted for CSRF-protected forms such as the admin.
DJANGO_CSRF_TRUSTED_ORIGINS=
# true enables HTTPS redirect, secure cookies and HSTS (the default when unset).
# Set false only for plain-HTTP local or LAN demos.
DJANGO_SECURE_HTTPS=false
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=sentinel
# Bootstrap superuser: used only by the postgres container and the test runner.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE_PASSWORD__
# Schema owner: runs migrations, owns tables.
DB_OWNER_USER=sentinel_owner
DB_OWNER_PASSWORD=__GENERATE_PASSWORD__
# Application role used by the API and Celery: data access only, no DDL.
DB_APP_USER=sentinel_app
DB_APP_PASSWORD=__GENERATE_PASSWORD__
DB_CONN_MAX_AGE=60
# Upper bound for any single SQL statement issued by the application.
DB_STATEMENT_TIMEOUT_MS=5000

# --- Redis (Celery broker and cache; never the source of truth) -------------
REDIS_PASSWORD=__GENERATE_PASSWORD__

# --- JWT (djangorestframework-simplejwt) --------------------------------------
# Separate from DJANGO_SECRET_KEY so either can be rotated independently.
JWT_SIGNING_KEY=__GENERATE_SECRET__
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_HOURS=24

# --- CORS (React / Next.js / Vite frontends) ----------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Observability ------------------------------------------------------------
# Prometheus must send "Authorization: Bearer <token>" to scrape /metrics.
METRICS_AUTH_TOKEN=__GENERATE_SECRET__

# --- Request and audit ingestion limits ---------------------------------------
# Maximum request body accepted by the API (bytes). 2.5 MiB by default.
API_MAX_REQUEST_BYTES=2621440
# Maximum number of events in one bulk ingestion request.
AUDIT_BULK_MAX_EVENTS=500
# Maximum serialized size of one event's metadata object (bytes).
AUDIT_METADATA_MAX_BYTES=8192

# --- Webhooks -----------------------------------------------------------------
# Comma-separated Fernet keys used to encrypt webhook signing secrets at rest.
# The first key encrypts new secrets; the others are still accepted for decryption
# so keys can be rotated without downtime.
WEBHOOK_SECRET_ENCRYPTION_KEYS=__GENERATE_FERNET_KEY__
# Development only: allow http:// and private or loopback destinations.
# Ignored unless DJANGO_DEBUG=true.
WEBHOOK_ALLOW_INSECURE_DESTINATIONS=false
WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
WEBHOOK_READ_TIMEOUT_SECONDS=5
# Retries after the first attempt (5 retries = at most 6 delivery attempts).
WEBHOOK_MAX_RETRIES=5

# --- Rate limits (DRF throttle rates) -----------------------------------------
THROTTLE_RATE_ANON=30/minute
THROTTLE_RATE_USER=600/minute
THROTTLE_RATE_AUTH=10/minute
THROTTLE_RATE_INGEST=1200/minute

# --- Process tuning -----------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
# Comma-separated proxy IPs allowed to set X-Forwarded-* headers.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
CELERY_WORKER_CONCURRENCY=2
